# ============================================================================
# sportudei — Development Environment
# Copy to .env and fill in values
# ============================================================================

APP_ENV=dev
PORT=8000

DB_USER=postgres
DB_PASSWORD=password
DB_NAME=sportudei
RUN_MIGRATIONS=true

# Generate: openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_EXP_DAYS=1
JWT_REFRESH_EXP_DAYS=3

RESEND_API_KEY=re_...
EMAIL_FROM=noreply@sportudei.com

CORS_ORIGINS=http://localhost:5173
UPLOAD_DIR=uploads