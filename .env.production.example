# ============================================================================
# sportudei — Production Environment
# Copy to .env on the server and fill in real values
# ============================================================================

APP_ENV=prod
PORT=8000

# Generate: openssl rand -base64 24
DB_USER=sportudei
DB_PASSWORD=
DB_NAME=sportudei
RUN_MIGRATIONS=true

# Generate: openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_EXP_DAYS=1
JWT_REFRESH_EXP_DAYS=7

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@sportudei.com

CORS_ORIGINS=https://sportudei.com,https://www.sportudei.com
UPLOAD_DIR=uploads
